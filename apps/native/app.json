{
  "expo": {
    "scheme": "clock-app-for-my-crusty-ipad",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.yuanhau.clockhomeintergrationapplication",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app needs access to your local network to function properly."
      }
    },
    "name": "Clock/Home Intergration App",
    "slug": "clock-app-for-my-crusty-ipad",
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.yuanhau.clockhomeintergrationapplication"
    }
  }
}
